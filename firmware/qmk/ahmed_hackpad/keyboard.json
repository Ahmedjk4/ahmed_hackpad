                { "matrix": [0, 0], "x": 0,   "y": 0 },
                { "matrix": [0, 1], "x": 1,   "y": 0 },
                { "matrix": [0, 2], "x": 0,   "y": 1 },
                { "matrix": [0, 3], "x": 1,   "y": 1 },
                { "matrix": [0, 4], "x": 2.5, "y": 0.5 }
            ]
        }
    }
}